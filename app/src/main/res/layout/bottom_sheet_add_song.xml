<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/dmh_surface"
    android:paddingBottom="16dp">

    <!-- Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:background="@color/dmh_surface_variant" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/add_song_title"
        android:textSize="18sp"
        android:textColor="@color/dmh_text_primary"
        android:textStyle="bold"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="12dp" />

    <!-- Source tabs -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabSource"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        app:tabSelectedTextColor="@color/dmh_accent"
        app:tabTextColor="@color/dmh_text_secondary"
        app:tabIndicatorColor="@color/dmh_accent"
        app:tabBackground="@color/dmh_surface"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Spotify" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="YouTube" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lokal" />

    </com.google.android.material.tabs.TabLayout>

    <!-- No-Spotify warning -->
    <TextView
        android:id="@+id/tvNoSpotify"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/spotify_not_connected_hint"
        android:textSize="12sp"
        android:textColor="@color/dmh_text_hint"
        android:paddingHorizontal="16dp"
        android:paddingVertical="4dp"
        android:visibility="gone" />

    <!-- Local file pick (shown only for Lokal tab) -->
    <Button
        android:id="@+id/btnPickLocalFile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        android:text="@string/pick_local_file"
        android:backgroundTint="@color/dmh_accent"
        android:textColor="@color/white"
        android:visibility="gone" />

    <!-- Search bar -->
    <LinearLayout
        android:id="@+id/llSearchBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:hint="@string/search_hint"
            app:boxStrokeColor="@color/dmh_accent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:textColor="@color/dmh_text_primary" />

        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/btnSearch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/search"
            android:backgroundTint="@color/dmh_accent"
            android:textColor="@color/white"
            android:layout_marginStart="8dp" />

    </LinearLayout> <!-- end llSearchBar -->

    <!-- Loading -->
    <ProgressBar
        android:id="@+id/progressSearch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:indeterminateTint="@color/dmh_accent"
        android:visibility="gone" />

    <!-- Error text -->
    <TextView
        android:id="@+id/tvSearchError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/dmh_accent"
        android:textSize="13sp"
        android:paddingHorizontal="16dp"
        android:visibility="gone" />

    <!-- Results -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSearchResults"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />

</LinearLayout>
