<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dmh_bg"
    android:fitsSystemWindows="true">

    <!-- Toolbar -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:background="@color/dmh_surface"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="DMH"
            android:textColor="@color/dmh_accent"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSessionCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/dmh_text_secondary"
            android:textSize="12sp"
            android:letterSpacing="0.1"
            android:layout_marginEnd="2dp" />

        <ImageButton
            android:id="@+id/btnCopyCode"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_copy"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/btn_copy_code"
            app:tint="@color/dmh_text_secondary" />

        <!-- QR Code button -->
        <ImageButton
            android:id="@+id/btnShowQr"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_qr_scan"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/btn_show_qr"
            app:tint="@color/dmh_text_secondary"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnLeave"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_leave"
            android:textColor="@color/dmh_accent"
            android:minWidth="0dp"
            android:paddingHorizontal="8dp" />

    </LinearLayout>

    <!-- Reconnecting banner -->
    <TextView
        android:id="@+id/tvConnectionStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/reconnecting"
        android:textColor="@color/white"
        android:background="@color/dmh_accent"
        android:gravity="center"
        android:padding="6dp"
        android:textSize="12sp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Main scrollable content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/tvConnectionStatus"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Now Playing Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/dmh_surface"
                app:cardCornerRadius="12dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/now_playing"
                        android:textSize="11sp"
                        android:textColor="@color/dmh_text_hint"
                        android:letterSpacing="0.12"
                        android:textAllCaps="true"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/ivNpThumbnail"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_music_note"
                            android:background="@color/dmh_surface_variant"
                            android:layout_marginEnd="12dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvNpTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/no_track"
                                android:textColor="@color/dmh_text_primary"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:maxLines="2"
                                android:ellipsize="end" />

                            <TextView
                                android:id="@+id/tvNpArtist"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/dmh_text_secondary"
                                android:textSize="13sp"
                                android:maxLines="1"
                                android:ellipsize="end" />

                            <TextView
                                android:id="@+id/tvNpAddedBy"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/dmh_text_hint"
                                android:textSize="11sp" />

                        </LinearLayout>
                    </LinearLayout>

                    <!-- Progress bar -->
                    <ProgressBar
                        android:id="@+id/progressPlayback"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:max="100"
                        android:progress="0"
                        android:progressTint="@color/dmh_accent"
                        android:layout_marginTop="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvProgressCurrent"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="0:00"
                            android:textColor="@color/dmh_text_hint"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvProgressTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0:00"
                            android:textColor="@color/dmh_text_hint"
                            android:textSize="11sp" />

                    </LinearLayout>

                    <!-- Host playback controls -->
                    <LinearLayout
                        android:id="@+id/layoutPlayback"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginTop="8dp"
                        android:visibility="gone">

                        <ImageButton
                            android:id="@+id/btnPrev"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_skip_prev"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/prev"
                            app:tint="@color/dmh_text_primary" />

                        <ImageButton
                            android:id="@+id/btnPlayPause"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:src="@drawable/ic_play"
                            android:background="@drawable/bg_play_button"
                            android:contentDescription="@string/play_pause"
                            android:layout_marginHorizontal="16dp"
                            app:tint="@color/white" />

                        <ImageButton
                            android:id="@+id/btnNext"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_skip_next"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/next"
                            app:tint="@color/dmh_text_primary" />

                    </LinearLayout>

                    <!-- Guest info -->
                    <TextView
                        android:id="@+id/layoutGuestInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/guest_mode_hint"
                        android:textColor="@color/dmh_text_hint"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:layout_marginTop="8dp"
                        android:visibility="gone" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Host Settings Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/layoutHostControls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/dmh_surface"
                app:cardCornerRadius="12dp"
                android:layout_marginBottom="12dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/session_settings"
                        android:textSize="11sp"
                        android:textColor="@color/dmh_text_secondary"
                        android:textAllCaps="true"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/allow_join"
                            android:textColor="@color/dmh_text_primary"
                            android:textSize="14sp" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchAllowJoin"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            app:thumbTint="@color/dmh_accent"
                            app:trackTint="@color/dmh_surface_variant" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/allow_guest_add"
                            android:textColor="@color/dmh_text_primary"
                            android:textSize="14sp" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchAllowAdd"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            app:thumbTint="@color/dmh_accent"
                            app:trackTint="@color/dmh_surface_variant" />

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Queue Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/dmh_surface"
                app:cardCornerRadius="12dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Queue header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/queue"
                            android:textSize="16sp"
                            android:textColor="@color/dmh_text_primary"
                            android:textStyle="bold" />

                        <!-- Add Song button -->
                        <Button
                            android:id="@+id/btnAddSong"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/btn_add_song"
                            android:textColor="@color/dmh_accent"
                            android:textSize="12sp"
                            android:visibility="gone" />

                        <Button
                            android:id="@+id/btnOpenWeb"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/open_in_browser"
                            android:textColor="@color/dmh_text_hint"
                            android:textSize="11sp" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvQueueEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/queue_empty"
                        android:textColor="@color/dmh_text_hint"
                        android:textSize="13sp"
                        android:gravity="center"
                        android:padding="24dp"
                        android:visibility="gone" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvQueue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Participants Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/dmh_surface"
                app:cardCornerRadius="12dp"
                android:layout_marginBottom="32dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvParticipantCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/participants"
                        android:textSize="16sp"
                        android:textColor="@color/dmh_text_primary"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvParticipants"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
